# Mẫu biến môi trường. Sao chép thành .env; KHÔNG commit .env.
#
# Hai cách dùng:
#   - Chạy cục bộ (dev):   export biến ra môi trường shell rồi `python src/manage.py ...`
#                          (manage.py KHÔNG tự đọc tệp .env — xem README.md).
#   - Chạy bằng Docker:    deploy/scripts/install.sh tự sinh deploy/.env với khoá bí mật ngẫu
#                          nhiên; Docker Compose là nơi đọc tệp .env đó.

DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Biến bắt buộc của config/settings/prod.py ------------------------------
SECRET_KEY=change-me
# Phải chứa cả localhost,127.0.0.1: healthcheck của container gọi http://127.0.0.1:8000/healthz
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://procurement:procurement@localhost:5432/procurement
# Khoá Fernet (44 ký tự base64url) để mã hoá dữ liệu nhạy cảm (mật khẩu SMTP...):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Địa chỉ gốc dùng dựng liên kết tuyệt đối trong email
SITE_URL=http://localhost:8000

# --- Biến không bắt buộc ---------------------------------------------------
# Chuyển hướng HTTP → HTTPS (1 = bật, mặc định bật ở prod; chỉ tắt khi thử nghiệm không TLS)
SECURE_SSL_REDIRECT=1
# Số proxy tin cậy đứng trước ứng dụng (nginx = 1) để lấy đúng IP người dùng trong audit
TRUSTED_PROXY_COUNT=0

# --- Entra ID (bỏ trống = đăng nhập bằng mật khẩu + TOTP) ------------------
# Redirect URI khai báo trong Entra ID: https://<tên miền>/oidc/callback/
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_TENANT_ID=

# --- Chỉ dùng khi chạy bằng Docker (deploy/docker-compose.yml) -------------
# Hai role CSDL: procurement_owner sở hữu schema và chạy migrate, procurement_app chạy ứng dụng.
POSTGRES_DB=procurement
DB_OWNER_USER=procurement_owner
DB_OWNER_PASSWORD=
DB_APP_USER=procurement_app
DB_APP_PASSWORD=
# DATABASE_URL ở trên dùng role procurement_app; migrate/apply_db_grants dùng URL của owner:
DATABASE_URL_OWNER=postgres://procurement_owner:@db:5432/procurement
# Sao lưu (deploy/scripts/backup.sh): nơi lưu và số bản giữ lại
BACKUP_DIR=./backups
BACKUP_KEEP=30
